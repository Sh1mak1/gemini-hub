APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Tokyo
APP_DB_TIMEZONE=UTC
LOG_OPERATIONS_LOG_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Docker)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_MS=2000
GEMINI_REFERENCE_TIMEZONE=Asia/Tokyo

# Slack Events API
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_WORK=
SLACK_CHANNEL_HOBBY=
SLACK_CHANNEL_NAME_WORK=todo-work
SLACK_CHANNEL_NAME_HOBBY=todo-hobby
# other カテゴリ用（未設定時は Slack 投稿元チャンネルに通知）
SLACK_CHANNEL_OTHER=
SLACK_CHANNEL_NAME_OTHER=
# 本日期限タスクの朝次投稿（#kyou 等 / 9時 JST）
# SLACK_CHANNEL_TODAY を設定すると conversations.list 不要（推奨）
# Bot は各チャンネルへ手動招待が必要（channels:join スコープは未使用）
SLACK_CHANNEL_TODAY=
SLACK_CHANNEL_NAME_TODAY=kyou
SLACK_TODAY_POST_HOUR=9

# Drafts API (iOS Drafts から Bearer トークンで認証)
DRAFTS_API_TOKEN=
DRAFTS_CACHE_TTL=1440
